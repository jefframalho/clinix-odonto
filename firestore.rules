rules_version = '2';
// REGRAS DE SEGURANÇA DO CLINIX ODONTO
// Cole no Firebase: Firestore Database > Regras > Publicar.
// Troque o e-mail abaixo se o administrador for outro (o mesmo do config.js).
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['jeffersonramalhopb@gmail.com']; }
    function myDoc() { return /databases/$(db)/documents/usuarios/$(request.auth.uid); }
    function me() { return get(myDoc()).data; }
    function member(cid) { return signedIn() && exists(myDoc()) && me().cid == cid; }
    function isOwner(cid) { return member(cid) && me().papel == 'dono'; }
    function clinic(cid) { return get(/databases/$(db)/documents/clinicas/$(cid)).data; }
    // Clínica liberada: não bloqueada e vencimento há no máximo 5 dias (carência)
    // Dono da rede: quem criou a clínica (campo "dono") pode ter várias clínicas
    function isNetOwner(cid) { return signedIn() && clinic(cid).dono == request.auth.uid; }
    function active(cid) { return clinic(cid).status != 'bloqueado' && clinic(cid).vencimento > request.time - duration.value(5, 'd'); }

    // Quem é quem: cada usuário aponta para a sua clínica
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || (exists(myDoc()) && resource.data.cid == me().cid));
      allow create: if isAdmin()
        || (request.auth.uid == uid && request.resource.data.papel == 'dono'
            && get(/databases/$(db)/documents/clinicas/$(request.resource.data.cid)).data.dono == uid)
        || (isOwner(request.resource.data.cid) && request.resource.data.papel == 'equipe')
        // o dono da rede cria o login de cada clínica dele
        || (request.auth.uid != uid && isNetOwner(request.resource.data.cid) && request.resource.data.papel in ['dono', 'equipe']);
      // o dono da rede troca a clínica aberta, só para clínicas que são dele
      allow update: if isAdmin()
        || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cid'])
            && isNetOwner(request.resource.data.cid));
      allow delete: if isAdmin() || (isOwner(resource.data.cid) && resource.data.papel == 'equipe')
        || (request.auth.uid != uid && isNetOwner(resource.data.cid));
    }

    // Clínicas: a dona edita nome/logo, mas só o administrador mexe em plano e vencimento
    match /clinicas/{cid} {
      allow read: if isAdmin() || member(cid) || (signedIn() && resource.data.dono == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.status == 'teste'
        && request.resource.data.vencimento <= request.time + duration.value(15, 'd')
        && !('creditosConsulta' in request.resource.data);
      allow update: if isAdmin() || (isOwner(cid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'vencimento', 'valor', 'dono', 'pagamentos', 'criadoEm', 'creditosConsulta']))
        || (signedIn() && resource.data.dono == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acessos']));
      allow delete: if isAdmin();

      // Dados da clínica (pacientes, agenda, etc.): só a equipe da própria clínica, e só com mensalidade em dia.
      // O financeiro ("fin") só a responsável vê.
      // As consultas SPC/Serasa só o servidor grava; só a responsável lê.
      match /{col}/{doc} {
        allow read: if isAdmin() || (member(cid) && active(cid) && (col != 'fin' || me().papel == 'dono') && (col != 'consultas' || me().papel == 'dono'));
        allow write: if isAdmin() || (member(cid) && active(cid) && (col != 'fin' || me().papel == 'dono') && col != 'consultas');
      }
    }

    // Documentos para o paciente assinar pelo link (o código do link é secreto e aleatório).
    // Qualquer pessoa com o link lê; o paciente só pode marcar como assinado uma vez.
    match /assinaturas/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if member(request.resource.data.cid) && active(request.resource.data.cid);
      allow update: if member(resource.data.cid)
        || (resource.data.status == 'pendente' && request.resource.data.status == 'assinado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assinatura']));
      allow delete: if member(resource.data.cid) || isAdmin();
    }

    // Ficha de saúde (anamnese) respondida pelo paciente pelo link. Só pode responder uma vez.
    match /anamneses/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if member(request.resource.data.cid) && active(request.resource.data.cid);
      allow update: if member(resource.data.cid)
        || (resource.data.status == 'pendente' && request.resource.data.status == 'respondida'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respostas']));
      allow delete: if member(resource.data.cid) || isAdmin();
    }

    // Página pública da clínica (link da bio do Instagram). Qualquer pessoa lê;
    // só a equipe da própria clínica cria e altera, e não pode tomar o endereço de outra clínica.
    match /paginas/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if member(request.resource.data.cid) && active(request.resource.data.cid);
      allow update: if member(resource.data.cid) && request.resource.data.cid == resource.data.cid;
      allow delete: if member(resource.data.cid) || isAdmin();
    }

    // Cobrança enviada ao paciente (página de pagamento por Pix). Qualquer pessoa com o link lê;
    // o paciente só pode avisar que pagou (aberta -> informado). A clínica confirma.
    match /cobrancas/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if member(request.resource.data.cid) && active(request.resource.data.cid);
      allow update: if member(resource.data.cid)
        || (resource.data.status == 'aberta' && request.resource.data.status == 'informado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'informadoEm']));
      allow delete: if member(resource.data.cid) || isAdmin();
    }

    // Agendamento online: horários livres públicos (sem nomes de pacientes) e pedidos dos pacientes.
    match /agendas/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if member(request.resource.data.cid) && active(request.resource.data.cid);
      allow delete: if member(resource.data.cid) || isAdmin();
      match /pedidos/{id} {
        allow create: if get(/databases/$(db)/documents/agendas/$(token)).data.ativo == true
          && request.resource.data.keys().hasOnly(['nome', 'fone', 'data', 'hora', 'proc', 'prof', 'obs', 'criado', 'queixa', 'saude', 'nasc', 'novo', 'slot'])
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 100
          && request.resource.data.fone is string && request.resource.data.fone.size() <= 20
          && request.resource.data.obs is string && request.resource.data.obs.size() <= 200
          && (!('queixa' in request.resource.data) || (request.resource.data.queixa is string && request.resource.data.queixa.size() <= 500))
          && (!('saude' in request.resource.data) || (request.resource.data.saude is string && request.resource.data.saude.size() <= 500))
          && (!('nasc' in request.resource.data) || (request.resource.data.nasc is string && request.resource.data.nasc.size() <= 10))
          && (!('novo' in request.resource.data) || request.resource.data.novo is bool)
          // pedido com horário só nasce junto com a reserva desse horário (mesmo lote)
          && (!('slot' in request.resource.data) || (request.resource.data.slot is string
              && existsAfter(/databases/$(db)/documents/agendas/$(token)/reservas/$(request.resource.data.slot))));
        allow read, delete: if member(get(/databases/$(db)/documents/agendas/$(token)).data.cid)
          || isAdmin();
        allow update: if false;
      }

      // Reserva de horário: enquanto o pedido está em análise, o horário não pode ser pedido por outra pessoa.
      // O paciente só cria (uma vez por horário, não dá para trocar) e só consegue ver se UM horário está reservado.
      // A clínica apaga a reserva ao aceitar ou recusar o pedido.
      match /reservas/{slot} {
        allow get: if true;
        allow list: if false;
        allow create: if get(/databases/$(db)/documents/agendas/$(token)).data.ativo == true
          && request.resource.data.keys().hasOnly(['criado', 'slot'])
          && request.resource.data.slot == slot
          && slot.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}_[A-Za-z0-9_-]{1,40}$');
        allow update: if false;
        allow delete: if member(get(/databases/$(db)/documents/agendas/$(token)).data.cid) || isAdmin();
      }
    }
  }
}
