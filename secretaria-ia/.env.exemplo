# Copie este arquivo para ".env" (no seu PC) ou cadastre estes valores no Render.

# Gemini: crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase do Clinix (os mesmos do config.js)
FIREBASE_API_KEY=AIzaSyDhBKEhZEeNVRy6i1d4HZKq9Ga1lnvraOU
FIREBASE_PROJECT_ID=clinix-odonto

# WhatsApp (Meta for Developers > seu app > WhatsApp > Configuração da API)
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=invente-uma-senha-aqui
WHATSAPP_APP_SECRET=
GRAPH_VERSION=v23.0

# Qual número é de qual clínica: {"ID_DO_NUMERO":"CODIGO_DA_AGENDA"}
CLINICAS={"123456789012345":"codigo-da-agenda"}

TZ=America/Fortaleza

# ---------- Consulta SPC/Serasa ----------
# Chave de serviço do Firebase (o mesmo JSON usado no backup), tudo numa linha
FIREBASE_SERVICE_ACCOUNT=
# "teste" = dados simulados | "real" = consulta de verdade no fornecedor
CONSULTA_MODO=teste
# APIBrasil (SCPC Boa Vista)
CONSULTA_URL=https://gateway.apibrasil.io/api/v2/consulta/cpf/credits
CONSULTA_TOKEN=
CONSULTA_TIPO=spc-boa-vista
CONSULTA_HOMOLOG=false
CONSULTA_CAMPO_CPF=cpf
# Sites que podem pedir consultas
ORIGENS=https://app.clinixodonto.com.br,https://clinix-odonto.web.app,https://jefframalho.github.io
